# Copy to .env before running locally.
NODE_ENV=development
PORT=4000
TRUST_PROXY=false

# SQLite database file. The directory is created automatically.
DATABASE_PATH=./data/photobooth.sqlite

# Private media storage. This directory is never served statically.
UPLOAD_DIR=./storage/uploads

# Guest sessions expire after this many hours.
SESSION_TTL_HOURS=24
SHARE_TTL_HOURS=24

# Built frontend location used by the production server.
WEB_DIST=./dist

# Domain for the optional Caddy service in docker-compose.yml.
# Use your real domain in production; localhost uses Caddy's internal CA.
MOMENT_DOMAIN=localhost
