# Copy to .env before running locally.
NODE_ENV=development
PORT=4000
TRUST_PROXY=false

# PostgreSQL connection string. docker-compose sets this automatically.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/moment
# Force TLS for the database connection. Defaults to on for non-local hosts.
# DATABASE_SSL=true

# Vercel Blob read-write token. Required for uploads and media downloads.
BLOB_READ_WRITE_TOKEN=

# Guest sessions expire after this many hours.
SESSION_TTL_HOURS=24
SHARE_TTL_HOURS=24

# Built frontend location used by the production server.
WEB_DIST=./dist

# Protects the /api/cron/cleanup endpoint. Required in production.
CRON_SECRET=

# Domain for the optional Caddy service in docker-compose.yml.
# Use your real domain in production; localhost uses Caddy's internal CA.
MOMENT_DOMAIN=localhost

# Password for the docker-compose PostgreSQL service.
POSTGRES_PASSWORD=moment
