{
  "name": "moment-photobooth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MOMENT — a secure Korean-style photobooth experience.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist-server',{recursive:true,force:true});\"",
    "build": "npm run typecheck && vite build && npm run clean && tsc -p tsconfig.server.build.json && npm run build:api",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist-server/server/index.js",
    "preview": "vite preview",
    "build:api": "node scripts/build-api.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "esbuild": "^0.28.2"
  }
}
