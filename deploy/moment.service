[Unit]
Description=MOMENT photobooth
Documentation=https://github.com/halamikel/moment-photobooth
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moment
Group=moment
WorkingDirectory=/var/www/moment
EnvironmentFile=/var/www/moment/.env
ExecStart=/usr/bin/node dist-server/api/index.js
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
StateDirectory=moment
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
